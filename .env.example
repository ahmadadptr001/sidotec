# Salin berkas ini menjadi `.env`, lalu isi setiap nilainya.
# Jangan pernah commit `.env` yang sudah terisi.

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Keamanan sesi ---
# Kunci HMAC untuk menandatangani cookie sesi. WAJIB diisi, minimal 32 karakter.
# Tanpa nilai ini, login akan selalu gagal (fail closed) karena cookie tidak bisa
# ditandatangani maupun diverifikasi.
#
# Buat nilai acak dengan:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
#
# Catatan: mengganti nilai ini membatalkan seluruh sesi yang sedang aktif.
AUTH_SECRET=
